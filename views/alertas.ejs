<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: 'Alertas | Asistencia Escolar' }) %>
</head>
<body class="alertas-page">
  <%- include('partials/nav') %>
  <main class="container">
    <header class="page-head">
      <div class="page-head-text">
        <p class="page-kicker">Seguimiento temprano</p>
        <h1 class="page-title">Alertas de ausentismo</h1>
        <p class="page-sub">Cada alerta explica su motivo y las ausencias que la activaron.</p>
      </div>
      <div class="page-head-actions">
        <% if (usuario.rol === 'admin') { %>
          <form method="post" action="/alertas/recalcular">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost" type="submit"><%- include('partials/icono', { nombre: 'tendencia' }) %>Recalcular todas</button>
          </form>
        <% } %>
      </div>
    </header>

    <% if (flash) { %><div class="alert alert-info" role="status"><%- include('partials/icono', { nombre: 'info' }) %><span><%= flash %></span></div><% } %>

    <section class="alertas-resumen" aria-label="Resumen de alertas">
      <article class="alerta-resumen resumen-alto">
        <span class="alerta-resumen-icono" aria-hidden="true"><%- include('partials/icono', { nombre: 'alerta' }) %></span>
        <div><span class="alerta-resumen-valor"><%= resumen.alto %></span><span class="alerta-resumen-etiqueta">Altas pendientes</span></div>
      </article>
      <article class="alerta-resumen resumen-medio">
        <span class="alerta-resumen-icono" aria-hidden="true"><%- include('partials/icono', { nombre: 'reloj' }) %></span>
        <div><span class="alerta-resumen-valor"><%= resumen.medio %></span><span class="alerta-resumen-etiqueta">Medias pendientes</span></div>
      </article>
      <article class="alerta-resumen resumen-pendientes">
        <span class="alerta-resumen-icono" aria-hidden="true"><%- include('partials/icono', { nombre: 'reportes' }) %></span>
        <div><span class="alerta-resumen-valor"><%= resumen.pendientes %></span><span class="alerta-resumen-etiqueta">Total pendientes</span></div>
      </article>
    </section>

    <p class="alertas-regla"><%- include('partials/icono', { nombre: 'info' }) %><span>Tres ausencias no justificadas en 30 días generan nivel medio; cinco ausencias o una racha de tres días generan nivel alto.</span></p>

    <form class="filtros-barra" method="get" action="/alertas">
      <div class="filtros-campo">
        <label class="form-label" for="nivel">Nivel</label>
        <select class="form-select" id="nivel" name="nivel">
          <option value="">Todos los niveles</option>
          <% for (const valor of ['alto', 'medio', 'bajo']) { %><option value="<%= valor %>" <%= nivel === valor ? 'selected' : '' %>><%= valor.charAt(0).toUpperCase() + valor.slice(1) %></option><% } %>
        </select>
      </div>
      <div class="filtros-campo">
        <label class="form-label" for="estado">Estado</label>
        <select class="form-select" id="estado" name="estado">
          <option value="">Todos los estados</option>
          <% for (const valor of ['pendiente', 'atendida']) { %><option value="<%= valor %>" <%= estado === valor ? 'selected' : '' %>><%= valor.charAt(0).toUpperCase() + valor.slice(1) %></option><% } %>
        </select>
      </div>
      <div class="filtros-campo flex-grow-0">
        <button class="btn btn-outline-primary" type="submit"><%- include('partials/icono', { nombre: 'buscar' }) %>Filtrar</button>
      </div>
    </form>

    <% if (alertas.length === 0) { %>
      <div class="empty-state">
        <%- include('partials/icono', { nombre: 'check' }) %>
        <strong>No hay alertas con esos filtros</strong>
        <p>Prueba con otro nivel o revisa si las alertas ya fueron atendidas.</p>
      </div>
    <% } else { %>
      <div class="alertas-lista">
        <% for (const alerta of alertas) { %>
          <article class="alerta-card alerta-<%= alerta.nivel %>" data-elemento-buscable data-texto-busqueda="<%= alerta.nombre %> <%= alerta.apellido %> <%= alerta.numero_lista %> <%= alerta.curso %> <%= alerta.seccion %>">
            <header class="alerta-card-header">
              <div class="alerta-card-identidad">
                <h2 class="alerta-estudiante"><%= alerta.nombre %> <%= alerta.apellido %></h2>
                <p class="alerta-metadatos">
                  <span><%= alerta.curso %> · Sección <%= alerta.seccion %></span>
                  <span>Lista N° <%= alerta.numero_lista %></span>
                  <span>Detectada el <%= alerta.fecha_deteccion %></span>
                </p>
              </div>
              <span class="badge nivel-<%= alerta.nivel %> alerta-nivel"><%= alerta.nivel.toUpperCase() %></span>
            </header>

            <section class="alerta-motivo" aria-label="Motivo de alerta">
              <h3 class="alerta-seccion-titulo">Motivo de alerta</h3>
              <p class="alerta-descripcion"><%= alerta.mensaje %></p>
              <p class="alerta-recomendacion"><strong>Recomendación:</strong> conversar con el estudiante y coordinar seguimiento con su familia.</p>
            </section>

            <div class="alerta-estadisticas" aria-label="Estadísticas de asistencia">
              <div class="alerta-estadistica">
                <span class="alerta-estadistica-valor"><%= alerta.faltas_30_dias %></span>
                <span class="alerta-estadistica-etiqueta">Ausencias <small>en 30 días</small></span>
              </div>
              <div class="alerta-estadistica">
                <span class="alerta-estadistica-valor"><%= alerta.racha_maxima %></span>
                <span class="alerta-estadistica-etiqueta">Racha máxima <small>días</small></span>
              </div>
            </div>

            <footer class="alerta-card-footer">
              <% if (alerta.estado === 'pendiente') { %>
                <span class="alerta-estado estado-pendiente"><span aria-hidden="true">◷</span> Pendiente</span>
                <form class="alerta-formulario" method="post" action="/alertas/<%= alerta.id %>/atender">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input class="form-control" name="nota" maxlength="200" placeholder="Acción tomada" aria-label="Acción tomada" required>
                  <button class="btn btn-success" type="submit">Atender</button>
                </form>
              <% } else { %>
                <span class="alerta-estado estado-atendida"><span aria-hidden="true">✓</span> Atendida</span>
              <% } %>
            </footer>
          </article>
        <% } %>
      </div>
    <% } %>
  </main>
</body>
</html>
