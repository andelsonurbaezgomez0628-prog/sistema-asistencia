<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Alertas | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h1 class="h3 mb-0">Alertas de ausentismo</h1>
      <% if (usuario.rol === 'admin') { %>
        <form method="post" action="/alertas/recalcular">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline-primary" type="submit">Recalcular todas</button>
        </form>
      <% } %>
    </div>
    <% if (flash) { %><div class="alert alert-info"><%= flash %></div><% } %>
    <p class="text-secondary">Tres ausencias no justificadas en 30 dias generan nivel medio; cinco o una racha de tres dias generan nivel alto.</p>
    <div class="row g-3 mb-3">
      <div class="col-sm-4"><div class="border rounded p-3"><strong><%= resumen.alto %></strong><div>Altas pendientes</div></div></div>
      <div class="col-sm-4"><div class="border rounded p-3"><strong><%= resumen.medio %></strong><div>Medias pendientes</div></div></div>
      <div class="col-sm-4"><div class="border rounded p-3"><strong><%= resumen.pendientes %></strong><div>Total pendientes</div></div></div>
    </div>
    <form class="row g-2 mb-3" method="get" action="/alertas">
      <div class="col-sm-4"><label class="form-label" for="nivel">Nivel</label><select class="form-select" id="nivel" name="nivel"><option value="">Todos</option><% for (const valor of ['alto', 'medio', 'bajo']) { %><option value="<%= valor %>" <%= nivel === valor ? 'selected' : '' %>><%= valor %></option><% } %></select></div>
      <div class="col-sm-4"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado"><option value="">Todos</option><% for (const valor of ['pendiente', 'atendida']) { %><option value="<%= valor %>" <%= estado === valor ? 'selected' : '' %>><%= valor %></option><% } %></select></div>
      <div class="col-sm-4 d-flex align-items-end"><button class="btn btn-outline-primary w-100" type="submit">Filtrar</button></div>
    </form>
    <% if (alertas.length === 0) { %><div class="alert alert-success">No hay alertas con esos filtros.</div><% } %>
    <div class="row g-3 alertas-lista">
      <% for (const alerta of alertas) { %>
        <div class="col-lg-6">
          <article class="alerta-card alerta-<%= alerta.nivel %> h-100">
            <header class="alerta-card-header">
              <div class="alerta-card-identidad">
                <h2 class="alerta-estudiante"><%= alerta.nombre %> <%= alerta.apellido %></h2>
                <p class="alerta-metadatos">
                  <span><%= alerta.curso %> · Sección <%= alerta.seccion %></span>
                  <span>Lista N° <%= alerta.numero_lista %></span>
                  <span>Detectada <%= alerta.fecha_deteccion %></span>
                </p>
              </div>
              <span class="badge nivel-<%= alerta.nivel %> alerta-nivel"><%= alerta.nivel.toUpperCase() %></span>
            </header>

            <section class="alerta-motivo" aria-label="Motivo de alerta">
              <h3 class="alerta-seccion-titulo">Motivo de alerta</h3>
              <p class="alerta-descripcion"><%= alerta.mensaje %></p>
              <p class="alerta-recomendacion"><strong>Recomendación:</strong> Conversar con el estudiante y coordinar seguimiento con su familia.</p>
            </section>

            <div class="alerta-estadisticas" aria-label="Estadisticas de asistencia">
              <div class="alerta-estadistica">
                <span class="alerta-estadistica-valor"><%= alerta.faltas_30_dias %></span>
                <span class="alerta-estadistica-etiqueta">Ausencias</span>
              </div>
              <div class="alerta-estadistica">
                <span class="alerta-estadistica-valor"><%= alerta.racha_maxima %></span>
                <span class="alerta-estadistica-etiqueta">Racha máxima <small>días</small></span>
              </div>
            </div>

            <footer class="alerta-card-footer">
              <% if (alerta.estado === 'pendiente') { %>
                <span class="alerta-estado estado-pendiente"><span aria-hidden="true">◷</span> Pendiente</span>
                <form class="alerta-formulario" method="post" action="/alertas/<%= alerta.id %>/atender">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input class="form-control" name="nota" maxlength="200" placeholder="Accion tomada" aria-label="Accion tomada" required>
                  <button class="btn btn-success" type="submit">Atender</button>
                </form>
              <% } else { %>
                <span class="alerta-estado estado-atendida"><span aria-hidden="true">✓</span> Atendida</span>
              <% } %>
            </footer>
          </article>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
