<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reportes | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body class="reportes-page">
  <%- include('partials/nav') %>
  <%
    const fechaCorta = (valor) => String(valor).split('-').reverse().join('/');
    const segmentos = [
      { clave: 'presentes', etiqueta: 'Asistencias', valor: resumenRegistros.presentes, color: '#10B981' },
      { clave: 'tardanzas', etiqueta: 'Tardanzas', valor: resumenRegistros.tardanzas, color: '#F59E0B' },
      { clave: 'ausencias', etiqueta: 'Ausencias', valor: resumenRegistros.ausencias, color: '#EF4444' },
      { clave: 'justificadas', etiqueta: 'Justificadas', valor: resumenRegistros.justificadas, color: '#2563EB' },
    ];
    // Cada porcion usa el perimetro del circulo como 100 unidades. El desfase
    // negativo arranca cada porcion donde termina la anterior.
    let acumulado = 0;
    for (const segmento of segmentos) {
      segmento.porcentaje = totalRegistros > 0 ? (segmento.valor / totalRegistros) * 100 : 0;
      segmento.desfase = -acumulado;
      acumulado += segmento.porcentaje;
    }
  %>
  <main class="container py-4">
    <header class="reportes-encabezado">
      <div>
        <p class="dashboard-kicker mb-1">Análisis académico</p>
        <h1 class="h3 mb-1 page-heading"><img class="page-icon" src="/icons/reporte-de-negocios.png" alt="" aria-hidden="true">Reporte de asistencia</h1>
        <p class="dashboard-subtitle mb-0">Consulta tendencias y registros por curso, sección y período.</p>
      </div>
      <a class="btn reportes-boton-panel" href="/">Panel</a>
    </header>
    <section class="reportes-filtros-panel" aria-label="Filtros del reporte">
      <form class="row g-2 align-items-end" method="get" action="/reportes">
      <div class="col-sm-6 col-lg-2"><label class="form-label" for="desde">Desde</label><input class="form-control" type="date" id="desde" name="desde" value="<%= desde %>" max="<%= hoy %>" required></div>
      <div class="col-sm-6 col-lg-2"><label class="form-label" for="hasta">Hasta</label><input class="form-control" type="date" id="hasta" name="hasta" value="<%= hasta %>" max="<%= hoy %>" required></div>
      <div class="col-sm-6 col-lg-3"><label class="form-label" for="curso">Curso</label><select class="form-select" id="curso" name="curso"><option value="">Todos</option><% for (const curso of cursos) { %><option value="<%= curso.id %>" <%= idCurso === Number(curso.id) ? 'selected' : '' %>><%= curso.nombre %></option><% } %></select></div>
      <div class="col-sm-6 col-lg-3"><label class="form-label" for="seccion">Seccion</label><select class="form-select" id="seccion" name="seccion"><option value="">Todas</option><% for (const seccion of secciones) { %><option value="<%= seccion.id %>" <%= idSeccion === Number(seccion.id) ? 'selected' : '' %>><%= seccion.curso %> · <%= seccion.nombre %></option><% } %></select></div>
      <div class="col-lg-2"><button class="btn btn-primary w-100" type="submit">Filtrar</button></div>
      </form>
    </section>

    <p class="reportes-rango reportes-contexto text-secondary">
      Del <strong><%= fechaCorta(desde) %></strong> al <strong><%= fechaCorta(hasta) %></strong>
      · <%= filas.length %> estudiante(s) · Asistencia general <strong><%= asistenciaGeneral %>%</strong>
    </p>

    <section class="reportes-graficos" aria-label="Reportes visuales">
      <article class="card grafico-card">
        <div class="card-header">
          <h2 class="h5 mb-0">Distribución de registros</h2>
          <p class="grafico-subtitulo mb-0"><%= totalRegistros %> registro(s) en el rango elegido</p>
        </div>
        <div class="card-body grafico-dona-cuerpo">
          <svg class="grafico-dona" viewBox="0 0 42 42" role="img" aria-label="Gráfico de pastel: distribución de registros entre asistencias, tardanzas, ausencias y justificadas">
            <circle class="grafico-dona-base" cx="21" cy="21" r="15.9155"></circle>
            <% for (const segmento of segmentos) { %>
              <% if (segmento.porcentaje > 0) { %>
                <circle cx="21" cy="21" r="15.9155" fill="none" stroke="<%= segmento.color %>" stroke-width="6"
                  pathLength="100" stroke-dasharray="<%= segmento.porcentaje.toFixed(2) %> <%= (100 - segmento.porcentaje).toFixed(2) %>"
                  stroke-dashoffset="<%= segmento.desfase.toFixed(2) %>" transform="rotate(-90 21 21)"></circle>
              <% } %>
            <% } %>
            <text class="grafico-dona-valor" x="21" y="20.5" text-anchor="middle"><%= totalRegistros > 0 ? `${asistenciaGeneral}%` : '--' %></text>
            <text class="grafico-dona-etiqueta" x="21" y="24.5" text-anchor="middle">asistencia</text>
          </svg>
          <ul class="grafico-leyenda">
            <% for (const segmento of segmentos) { %>
              <li class="grafico-leyenda-item">
                <span class="grafico-leyenda-color grafico-color-<%= segmento.clave %>" aria-hidden="true"></span>
                <span class="grafico-leyenda-nombre"><%= segmento.etiqueta %></span>
                <span class="grafico-leyenda-cifra"><%= segmento.valor %> <span class="grafico-leyenda-pct">(<%= Math.round(segmento.porcentaje) %>%)</span></span>
              </li>
            <% } %>
          </ul>
        </div>
      </article>

      <article class="card grafico-card">
        <div class="card-header">
          <h2 class="h5 mb-0">Asistencia por curso</h2>
          <p class="grafico-subtitulo mb-0">Tardanza cuenta como asistencia</p>
        </div>
        <div class="card-body">
          <% if (resumenCursos.length === 0) { %>
            <p class="text-secondary mb-0">No hay registros para esos filtros.</p>
          <% } else { %>
            <ul class="grafico-barras">
              <% for (const item of resumenCursos) { %>
                <li class="grafico-barra">
                  <span class="grafico-barra-nombre" title="<%= item.curso %>"><%= item.curso %></span>
                  <progress class="barra-asistencia" max="100" value="<%= item.porcentaje %>" aria-label="Asistencia de <%= item.curso %>: <%= item.porcentaje %>%"><%= item.porcentaje %>%</progress>
                  <span class="grafico-barra-valor"><%= item.porcentaje %>%</span>
                  <span class="grafico-barra-detalle"><%= item.asistencias %> de <%= item.dias %> día(s)</span>
                </li>
              <% } %>
            </ul>
          <% } %>
        </div>
      </article>
    </section>

    <section class="card reportes-detalle-card">
      <header class="card-header reportes-detalle-encabezado">
        <div>
          <h2 class="h5 mb-0">Detalle por estudiante</h2>
          <p class="grafico-subtitulo mb-0">Registros individuales para el rango seleccionado.</p>
        </div>
        <span class="reportes-total-estudiantes"><%= filas.length %> estudiantes</span>
      </header>
      <div class="reportes-estudiantes-grid">
        <% for (const fila of filas) { const diasRegistradosFila = Number(fila.dias_registrados || 0); const porcentaje = diasRegistradosFila > 0 ? Math.round((Number(fila.asistencias || 0) / diasRegistradosFila) * 100) : 0; %>
          <article class="reportes-estudiante-card">
            <header class="reportes-estudiante-encabezado">
              <div class="reportes-estudiante-identidad">
                <span class="reportes-estudiante-icono" aria-hidden="true"><img src="/icons/profesor.png" alt=""></span>
                <div>
                  <h3><%= fila.apellido %>, <%= fila.nombre %></h3>
                  <p>Lista N° <%= fila.numero_lista %> <span aria-hidden="true">·</span> <%= fila.curso %> · <%= fila.seccion %></p>
                </div>
              </div>
              <span class="reportes-estudiante-porcentaje"><%= diasRegistradosFila > 0 ? `${porcentaje}%` : '--' %></span>
            </header>

            <dl class="reportes-estudiante-metricas">
              <div class="estudiante-metrica metrica-asistencias"><dt>Asistencias</dt><dd><%= fila.asistencias || 0 %></dd></div>
              <div class="estudiante-metrica metrica-tardanzas"><dt>Tardanzas</dt><dd><%= fila.tardanzas || 0 %></dd></div>
              <div class="estudiante-metrica metrica-ausencias"><dt>Ausencias</dt><dd><%= fila.ausencias || 0 %></dd></div>
              <div class="estudiante-metrica metrica-justificadas"><dt>Justificadas</dt><dd><%= fila.justificadas || 0 %></dd></div>
            </dl>

            <div class="reportes-estudiante-progreso">
              <div class="reportes-estudiante-progreso-encabezado">
                <span>Porcentaje de asistencia</span>
                <% if (diasRegistradosFila > 0) { %><strong><%= porcentaje %>%</strong><% } else { %><span class="porcentaje-sin-datos">Sin registros</span><% } %>
              </div>
              <% if (diasRegistradosFila > 0) { %>
                <progress class="barra-asistencia" max="100" value="<%= porcentaje %>" aria-label="Asistencia de <%= fila.nombre %> <%= fila.apellido %>: <%= porcentaje %>%"><%= porcentaje %>%</progress>
              <% } %>
            </div>
          </article>
        <% } %>
      </div>
      <% if (filas.length === 0) { %><p class="text-secondary reportes-sin-resultados">No hay registros para esos filtros.</p><% } %>
    </section>
  </main>
</body>
</html>
