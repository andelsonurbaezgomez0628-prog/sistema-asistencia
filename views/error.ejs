<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: 'Error | Asistencia Escolar' }) %>
</head>
<body class="error-page">
  <main class="container error-shell">
    <section class="card error-card">
      <span class="error-icono" aria-hidden="true"><%- include('partials/icono', { nombre: 'alerta' }) %></span>
      <p class="page-kicker mb-2">Solicitud no completada</p>
      <h1 class="mb-2">No se pudo completar la solicitud</h1>
      <p class="text-secondary mb-4"><%= mensaje %></p>
      <a class="btn btn-primary" href="/"><%- include('partials/icono', { nombre: 'panel' }) %>Volver al panel</a>
    </section>
  </main>
</body>
</html>
