<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Asistencia | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0">Registrar asistencia</h1>
      <a class="btn btn-outline-secondary btn-sm" href="/">Panel</a>
    </div>
    <% if (flash) { %><div class="alert alert-info"><%= flash %></div><% } %>
    <form class="row g-2 align-items-end mb-3" method="get" action="/asistencia">
      <div class="col-md-6">
        <label class="form-label" for="seccion">Curso y seccion</label>
        <select class="form-select" id="seccion" name="seccion" required>
          <% for (const seccion of secciones) { %>
            <option value="<%= seccion.id %>" <%= Number(seccion.id) === idSeccion ? 'selected' : '' %>><%= seccion.curso %> · <%= seccion.nombre %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="fecha">Fecha</label>
        <input class="form-control" type="date" id="fecha" name="fecha" value="<%= fecha %>" max="<%= hoy %>" required>
      </div>
      <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Cargar lista</button></div>
    </form>
    <% if (secciones.length === 0) { %>
      <div class="alert alert-warning">No tienes secciones asignadas.</div>
    <% } else if (estudiantes.length === 0) { %>
      <div class="alert alert-secondary">No hay estudiantes activos para esta seccion y fecha.</div>
    <% } else { %>
      <form method="post" action="/asistencia">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="seccion_id" value="<%= idSeccion %>">
        <input type="hidden" name="fecha" value="<%= fecha %>">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead><tr><th>Estudiante</th><th>Estado</th><th>Observacion</th></tr></thead>
            <tbody>
              <% for (const estudiante of estudiantes) { %>
                <tr>
                  <td><strong><%= estudiante.apellido %>, <%= estudiante.nombre %></strong><div class="small text-secondary">Lista N° <%= estudiante.numero_lista %></div></td>
                  <td>
                    <select class="form-select" name="estado_<%= estudiante.id %>" required>
                      <option value="">Seleccionar</option>
                      <% for (const estado of ['presente', 'tardanza', 'ausente', 'justificado']) { %>
                        <option value="<%= estado %>" <%= estudiante.estado === estado ? 'selected' : '' %>><%= estado %></option>
                      <% } %>
                    </select>
                  </td>
                  <td><input class="form-control" name="observacion_<%= estudiante.id %>" maxlength="255" value="<%= estudiante.observacion || '' %>"></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <button class="btn btn-success" type="submit">Guardar y recalcular alertas</button>
      </form>
    <% } %>
  </main>
</body>
</html>