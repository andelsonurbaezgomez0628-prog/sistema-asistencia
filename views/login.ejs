<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesion | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body class="login-page">
  <main class="container login-shell">
    <section class="card login-card">
      <div class="card-body">
        <header class="login-brand">
          <img class="login-brand-icon" src="/icons/estudio.png" alt="" aria-hidden="true">
          <div><p class="login-brand-kicker mb-1">Portal institucional</p><h1 class="h3 mb-0">Asistencia Escolar</h1></div>
        </header>
        <p class="login-subtitulo">Ingresa con tu cuenta institucional.</p>
        <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
        <% if (flash) { %><div class="alert alert-info" role="status"><%= flash %></div><% } %>
        <form method="post" action="/login" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="usuario">Usuario</label>
            <input class="form-control" id="usuario" name="usuario" autocomplete="username" maxlength="50" required>
          </div>
          <div class="mb-4">
            <label class="form-label" for="clave">Contraseña</label>
            <input class="form-control" id="clave" name="clave" type="password" autocomplete="current-password" maxlength="200" required>
          </div>
          <button class="btn btn-primary w-100 login-boton" type="submit">Iniciar sesión</button>
        </form>
        <p class="login-pie mb-0">Acceso seguro para docentes y coordinación.</p>
      </div>
    </section>
  </main>
</body>
</html>
