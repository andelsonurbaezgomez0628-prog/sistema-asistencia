<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: 'Iniciar sesión | Asistencia Escolar' }) %>
</head>
<body class="login-page">
  <main class="login-shell">
    <section class="login-panel" aria-label="Presentación del sistema">
      <div class="login-pitch">
        <p class="login-panel-kicker">Control escolar, más claro</p>
        <h2>Asistencia clara, alertas a tiempo.</h2>
        <p>Un panel pensado para docentes y coordinación: registra la lista del día y detecta el ausentismo antes de que crezca.</p>
        <ul class="login-beneficios">
          <li><%- include('partials/icono', { nombre: 'check' }) %>Asistencia diaria en segundos</li>
          <li><%- include('partials/icono', { nombre: 'alertas' }) %>Alertas explicables por estudiante</li>
          <li><%- include('partials/icono', { nombre: 'candado' }) %>Acceso seguro por rol</li>
        </ul>
      </div>
    </section>

    <section class="login-card">
      <div class="login-brand">
        <span class="login-brand-icon" aria-hidden="true"><img src="/icons/Emblema%20tecnol%C3%B3gico%20de%20IA%20y%20verificaci%C3%B3n.png" alt=""></span>
        <div>
          <p class="login-brand-kicker">Portal institucional</p>
          <h1>Asistencia Escolar</h1>
        </div>
      </div>
      <div class="login-formulario">
        <p class="login-eyebrow">Bienvenido</p>
        <h1>Inicia sesión</h1>
        <p class="login-subtitulo">Ingresa con tu cuenta institucional.</p>
        <% if (error) { %><div class="alert alert-danger" role="alert"><%- include('partials/icono', { nombre: 'alerta' }) %><span><%= error %></span></div><% } %>
        <% if (flash) { %><div class="alert alert-info" role="status"><%- include('partials/icono', { nombre: 'info' }) %><span><%= flash %></span></div><% } %>
        <form method="post" action="/login" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="usuario">Usuario</label>
            <input class="form-control" id="usuario" name="usuario" autocomplete="username" maxlength="50" placeholder="tu.usuario" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="clave">Contraseña</label>
            <input class="form-control" id="clave" name="clave" type="password" autocomplete="current-password" maxlength="200" placeholder="Tu contraseña" required>
          </div>
          <button class="btn btn-primary w-100 login-boton" type="submit">Entrar al panel <%- include('partials/icono', { nombre: 'flecha-izq', clase: 'icono-volteado' }) %></button>
        </form>
        <p class="login-pie mb-0">Acceso seguro para docentes y coordinación.</p>
      </div>
    </section>
  </main>
</body>
</html>
