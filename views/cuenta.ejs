<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cuenta | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container py-4">
    <h1 class="h3 mb-3">Cambiar contrasena</h1>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <form class="col-lg-6" method="post" action="/cuenta/clave" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3"><label class="form-label" for="clave_actual">Contrasena actual</label><input class="form-control" id="clave_actual" name="clave_actual" type="password" autocomplete="current-password" maxlength="200" required></div>
      <div class="mb-3"><label class="form-label" for="clave_nueva">Nueva contrasena</label><input class="form-control" id="clave_nueva" name="clave_nueva" type="password" autocomplete="new-password" minlength="4" maxlength="200" required></div>
      <div class="mb-3"><label class="form-label" for="confirmar_clave">Confirmar nueva contrasena</label><input class="form-control" id="confirmar_clave" name="confirmar_clave" type="password" autocomplete="new-password" minlength="4" maxlength="200" required></div>
      <button class="btn btn-primary" type="submit">Actualizar contrasena</button>
    </form>
  </main>
</body>
</html>
