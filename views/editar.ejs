<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Editar <%= tipo %> | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container py-4">
    <h1 class="h3 mb-3">Editar <%= tipo %></h1>
    <% if (flash) { %><div class="alert alert-info"><%= flash %></div><% } %>
    <form class="row g-3" method="post" action="/gestion/editar/<%= tipo %>/<%= registro.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (tipo === 'seccion') { %>
        <div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="50" value="<%= registro.nombre %>" required></div>
        <div class="col-md-6"><label class="form-label" for="anio">Ano escolar</label><input class="form-control" id="anio" name="anio_escolar" pattern="[0-9]{4}-[0-9]{4}" value="<%= registro.anio_escolar %>" required></div>
        <div class="col-md-6"><label class="form-label" for="curso">Curso</label><select class="form-select" id="curso" name="curso_id" required><% for (const curso of cursos) { %><option value="<%= curso.id %>" <%= Number(registro.curso_id) === Number(curso.id) ? 'selected' : '' %>><%= curso.nombre %></option><% } %></select></div>
        <div class="col-md-6"><label class="form-label" for="docente">Docente</label><select class="form-select" id="docente" name="docente_id" required><% for (const docente of docentes) { %><option value="<%= docente.id %>" <%= Number(registro.docente_id) === Number(docente.id) ? 'selected' : '' %>><%= docente.nombre %></option><% } %></select></div>
      <% } else if (tipo === 'estudiante') { %>
        <div class="col-md-4"><label class="form-label" for="numero_lista">Numero de lista</label><input class="form-control" id="numero_lista" name="numero_lista" type="number" min="1" max="40" step="1" value="<%= registro.numero_lista %>" required></div>
        <div class="col-md-4"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="80" value="<%= registro.nombre %>" required></div>
        <div class="col-md-4"><label class="form-label" for="apellido">Apellido</label><input class="form-control" id="apellido" name="apellido" maxlength="80" value="<%= registro.apellido %>" required></div>
        <div class="col-md-6"><label class="form-label" for="fecha">Fecha de nacimiento</label><input class="form-control" id="fecha" name="fecha_nacimiento" type="date" value="<%= registro.fecha_nacimiento || '' %>"></div>
        <div class="col-md-6"><label class="form-label" for="seccion">Seccion</label><select class="form-select" id="seccion" name="seccion_id" required><% for (const seccion of secciones) { %><option value="<%= seccion.id %>" <%= Number(registro.seccion_id) === Number(seccion.id) ? 'selected' : '' %>><%= seccion.curso %> · <%= seccion.nombre %></option><% } %></select></div>
        <div class="col-12 form-check ms-2"><input class="form-check-input" id="activo" name="activo" value="1" type="checkbox" <%= registro.activo ? 'checked' : '' %>><label class="form-check-label" for="activo">Estudiante activo</label></div>
      <% } else { %>
        <div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="120" value="<%= registro.nombre %>" required></div>
        <div class="col-md-6"><label class="form-label" for="cedula">Cedula</label><input class="form-control" id="cedula" name="cedula" pattern="[0-9]{7,8}" maxlength="8" value="<%= registro.cedula %>" required></div>
        <div class="col-md-6"><label class="form-label" for="usuario">Usuario</label><input class="form-control" id="usuario" name="usuario" pattern="[a-zA-Z0-9._-]{3,50}" maxlength="50" value="<%= registro.usuario %>" required></div>
        <div class="col-md-6"><label class="form-label" for="clave">Nueva contrasena (opcional)</label><input class="form-control" id="clave" name="clave" type="password" minlength="4" autocomplete="new-password"></div>
        <div class="col-12 form-check ms-2"><input class="form-check-input" id="activo" name="activo" value="1" type="checkbox" <%= registro.activo ? 'checked' : '' %>><label class="form-check-label" for="activo">Cuenta activa</label></div>
      <% } %>
      <div class="col-12"><button class="btn btn-primary" type="submit">Guardar cambios</button> <a class="btn btn-outline-secondary" href="/gestion">Cancelar</a></div>
    </form>
  </main>
</body>
</html>
