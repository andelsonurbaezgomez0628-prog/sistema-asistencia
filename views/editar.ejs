<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: `Editar ${tipo} | Asistencia Escolar` }) %>
</head>
<body class="edicion-page">
  <%- include('partials/nav') %>
  <main class="container">
    <% const iconoEdicion = tipo === 'estudiante' ? 'estudiante' : tipo === 'seccion' ? 'seccion' : 'docente'; %>
    <header class="edicion-encabezado">
      <div>
        <p class="page-kicker">Gestión académica</p>
        <h1>Editar <%= tipo %></h1>
        <p class="dashboard-subtitle mb-0">Actualiza los datos del registro seleccionado.</p>
      </div>
      <a class="btn btn-ghost edicion-boton-volver" href="/gestion"><%- include('partials/icono', { nombre: 'flecha-izq' }) %>Volver a gestión</a>
    </header>

    <% if (flash) { %><div class="alert alert-info" role="status"><%- include('partials/icono', { nombre: 'info' }) %><span><%= flash %></span></div><% } %>

    <section class="card edicion-card">
      <header class="card-header edicion-card-header">
        <div class="d-flex align-items-center gap-2">
          <span class="cuenta-seguridad-icono" aria-hidden="true"><%- include('partials/icono', { nombre: iconoEdicion }) %></span>
          <div>
            <h2 class="mb-0">Información del registro</h2>
            <p class="text-secondary small mb-0">Los cambios se guardan de inmediato al confirmar.</p>
          </div>
        </div>
      </header>
      <form class="row g-3 edicion-formulario" method="post" action="/gestion/editar/<%= tipo %>/<%= registro.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (tipo === 'seccion') { %>
          <div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="50" value="<%= registro.nombre %>" required></div>
          <div class="col-md-6"><label class="form-label" for="anio">Año escolar</label><input class="form-control" id="anio" name="anio_escolar" pattern="[0-9]{4}-[0-9]{4}" value="<%= registro.anio_escolar %>" required></div>
          <div class="col-md-6"><label class="form-label" for="curso">Curso</label><select class="form-select" id="curso" name="curso_id" required><% for (const curso of cursos) { %><option value="<%= curso.id %>" <%= Number(registro.curso_id) === Number(curso.id) ? 'selected' : '' %>><%= curso.nombre %></option><% } %></select></div>
          <fieldset class="col-12">
            <legend class="form-label">Docentes</legend>
            <div class="gestion-docentes-seleccion">
              <% for (const docente of docentes) { %>
                <label class="form-check gestion-docente-opcion">
                  <input class="form-check-input" type="checkbox" name="docente_ids" value="<%= docente.id %>" <%= docentesAsignados.includes(Number(docente.id)) ? 'checked' : '' %>>
                  <span class="form-check-label"><%= docente.nombre %><%= docente.activo ? '' : ' (inactivo; desmarcar para retirar)' %></span>
                </label>
              <% } %>
            </div>
            <div class="form-text">Selecciona uno o varios docentes activos.</div>
          </fieldset>
        <% } else if (tipo === 'estudiante') { %>
          <div class="col-md-4"><label class="form-label" for="numero_lista">Número de lista</label><input class="form-control" id="numero_lista" name="numero_lista" type="number" min="1" max="40" step="1" value="<%= registro.numero_lista %>" required></div>
          <div class="col-md-4"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="80" value="<%= registro.nombre %>" required></div>
          <div class="col-md-4"><label class="form-label" for="apellido">Apellido</label><input class="form-control" id="apellido" name="apellido" maxlength="80" value="<%= registro.apellido %>" required></div>
          <div class="col-md-6"><label class="form-label" for="fecha">Fecha de nacimiento</label><input class="form-control" id="fecha" name="fecha_nacimiento" type="date" value="<%= registro.fecha_nacimiento || '' %>"></div>
          <div class="col-md-6"><label class="form-label" for="seccion">Sección</label><select class="form-select" id="seccion" name="seccion_id" required><% for (const seccion of secciones) { %><option value="<%= seccion.id %>" <%= Number(registro.seccion_id) === Number(seccion.id) ? 'selected' : '' %>><%= seccion.curso %> · <%= seccion.nombre %></option><% } %></select></div>
          <div class="col-12 form-check ms-2"><input class="form-check-input" id="activo" name="activo" value="1" type="checkbox" <%= registro.activo ? 'checked' : '' %>><label class="form-check-label" for="activo">Estudiante activo</label></div>
        <% } else { %>
          <div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="120" value="<%= registro.nombre %>" required></div>
          <div class="col-md-6"><label class="form-label" for="cedula">Cédula</label><input class="form-control" id="cedula" name="cedula" pattern="[0-9]{7,8}" maxlength="8" value="<%= registro.cedula %>" required></div>
          <div class="col-md-6"><label class="form-label" for="usuario">Usuario</label><input class="form-control" id="usuario" name="usuario" pattern="[a-zA-Z0-9._-]{3,50}" maxlength="50" value="<%= registro.usuario %>" required></div>
          <div class="col-md-6"><label class="form-label" for="clave">Nueva contraseña (opcional)</label><input class="form-control" id="clave" name="clave" type="password" minlength="4" autocomplete="new-password" placeholder="Dejar vacío para conservar"></div>
          <div class="col-12 form-check ms-2"><input class="form-check-input" id="activo" name="activo" value="1" type="checkbox" <%= registro.activo ? 'checked' : '' %>><label class="form-check-label" for="activo">Cuenta activa</label></div>
        <% } %>
        <% if (tipo === 'estudiante' || tipo === 'docente' || tipo === 'administrador') { %>
          <div class="col-12 foto-subida" data-subida-foto data-tipo="<%= tipo === 'estudiante' ? 'estudiante' : 'usuario' %>" data-id="<%= registro.id %>" data-csrf="<%= csrfToken %>">
            <label class="form-label" for="foto-registro">Foto de perfil</label>
            <% if (registro.tiene_foto) { %><img class="foto-vista-previa" src="<%= tipo === 'estudiante' ? '/fotos/estudiantes/' : '/fotos/usuarios/' %><%= registro.id %>" alt="Foto actual"><% } %>
            <input class="form-control" id="foto-registro" type="file" accept="image/jpeg,image/png,image/webp" data-archivo-foto>
            <button class="btn btn-outline-primary mt-2" type="button" data-guardar-foto>Guardar foto</button>
            <span class="small" data-estado-foto aria-live="polite"></span>
          </div>
        <% } %>
        <div class="col-12 edicion-acciones">
          <button class="btn btn-primary" type="submit"><%- include('partials/icono', { nombre: 'check' }) %>Guardar cambios</button>
          <a class="btn btn-outline-secondary" href="/gestion">Cancelar</a>
        </div>
      </form>
    </section>
  </main>
  <script src="/js/foto-perfil.js" defer></script>
</body>
</html>
