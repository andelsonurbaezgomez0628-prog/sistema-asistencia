<header class="app-navbar navbar navbar-dark">
  <div class="container">
    <div class="navbar-top">
      <a class="navbar-brand" href="/">
        <img class="brand-icon" src="/icons/estudio.png" alt="" aria-hidden="true">
        <span>Asistencia Escolar</span>
      </a>
      <button class="nav-toggle" type="button" data-nav-toggle aria-controls="primaryMenu" aria-expanded="false" aria-label="Abrir menu">
        <span class="menu-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
    <div class="nav-collapse" id="primaryMenu">
      <nav class="primary-nav" aria-label="Navegacion principal">
        <a class="nav-item-icon <%= rutaActual === '/asistencia' ? 'active' : '' %>" href="/asistencia" <%= rutaActual === '/asistencia' ? 'aria-current="page"' : '' %>><img class="nav-icon" src="/icons/lista-de-verificacion.png" alt="" aria-hidden="true"><span>Asistencia</span></a>
        <a class="nav-item-icon <%= rutaActual.startsWith('/alertas') ? 'active' : '' %>" href="/alertas" <%= rutaActual.startsWith('/alertas') ? 'aria-current="page"' : '' %>><img class="nav-icon" src="/icons/alerta.png" alt="" aria-hidden="true"><span>Alertas</span></a>
        <a class="nav-item-icon <%= rutaActual === '/reportes' ? 'active' : '' %>" href="/reportes" <%= rutaActual === '/reportes' ? 'aria-current="page"' : '' %>><img class="nav-icon" src="/icons/reporte-de-negocios.png" alt="" aria-hidden="true"><span>Reportes</span></a>
        <a class="nav-item-icon <%= rutaActual === '/cuenta' ? 'active' : '' %>" href="/cuenta" <%= rutaActual === '/cuenta' ? 'aria-current="page"' : '' %>><img class="nav-icon" src="/icons/profesor.png" alt="" aria-hidden="true"><span>Cuenta</span></a>
        <% if (usuario.rol === 'admin') { %><a class="nav-item-icon <%= rutaActual.startsWith('/gestion') ? 'active' : '' %>" href="/gestion" <%= rutaActual.startsWith('/gestion') ? 'aria-current="page"' : '' %>><img class="nav-icon" src="/icons/secciones.png" alt="" aria-hidden="true"><span>Gestión</span></a><% } %>
      </nav>
      <div class="navbar-account">
        <span class="navbar-user" title="<%= usuario.nombre %>">
          <img class="nav-icon" src="/icons/profesor.png" alt="" aria-hidden="true">
          <span class="navbar-user-details">
            <span class="navbar-user-name"><%= usuario.nombre %></span>
            <span class="navbar-user-role"><%= usuario.rol === 'admin' ? 'Administrador' : 'Docente' %></span>
          </span>
        </span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline-light btn-sm nav-logout" type="submit">Salir</button>
        </form>
      </div>
    </div>
  </div>
  <script src="/js/nav.js" defer></script>
</header>
