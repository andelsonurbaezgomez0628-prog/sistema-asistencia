<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Panel | Asistencia Escolar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilos.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container py-4">
    <div class="dashboard-heading">
      <div>
        <p class="dashboard-kicker">Vista general</p>
        <h1 class="h3 mb-0 page-heading"><img class="page-icon" src="/icons/reporte-de-negocios%202.png" alt="" aria-hidden="true">Panel de seguimiento</h1>
      </div>
      <span class="dashboard-role"><%= usuario.rol === 'admin' ? 'Coordinacion' : 'Docente' %></span>
    </div>
    <% const etiquetas = { cursos: 'Cursos', secciones: 'Secciones', docentes: 'Docentes', estudiantes: 'Estudiantes activos', alertas: 'Alertas pendientes' }; %>
    <section class="dashboard-metrics" aria-label="Resumen">
      <% for (const [clave, valor] of Object.entries(resumen)) { %>
        <article class="dashboard-metric <%= clave === 'alertas' && Number(valor) > 0 ? 'metric-alerts' : '' %>">
          <h2><%= etiquetas[clave] || clave %></h2>
          <p><%= valor %></p>
        </article>
      <% } %>
    </section>
    <nav class="dashboard-actions" aria-label="Acciones principales">
      <a class="btn btn-primary" href="/asistencia"><img src="/icons/lista-de-verificacion.png" alt="" aria-hidden="true">Registrar asistencia</a>
      <a class="btn btn-outline-primary" href="/alertas"><img src="/icons/alerta.png" alt="" aria-hidden="true">Revisar alertas</a>
      <a class="btn btn-outline-primary" href="/reportes"><img src="/icons/reporte-de-negocios.png" alt="" aria-hidden="true">Abrir reportes</a>
      <% if (usuario.rol === 'admin') { %><a class="btn btn-outline-primary" href="/gestion"><img src="/icons/secciones.png" alt="" aria-hidden="true">Gestionar datos</a><% } %>
    </nav>
  </main>
</body>
</html>